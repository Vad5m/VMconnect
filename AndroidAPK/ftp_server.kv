<FtpButton>:
    canvas:
        Color:
            rgba: self.pressed_color if self.state == 'down' else self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]

<BackButton>:
    canvas.before:
        Color:
            rgba: (0.36, 0.36, 0.38, 1) if self.state == 'down' else (0.23, 0.23, 0.24, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<FtpServerRoot>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(12)

    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, None
        height: dp(48)
        spacing: dp(12)

        BackButton:
            id: btn_back

        Label:
            text: 'FTP Server'
            halign: 'left'
            valign: 'middle'
            font_size: dp(18)

    Label:
        text: root.status
        size_hint: 1, None
        height: dp(24)
        halign: 'left'
        valign: 'middle'
        font_size: dp(13)
        color: (0.7, 0.7, 0.7, 1)

    BoxLayout:
        orientation: 'vertical'
        size_hint: 1, None
        height: dp(260)
        spacing: dp(16)

        FtpButton:
            id: btn_open_phone
            bg_color: (0.16, 0.45, 0.9, 1)
            pressed_color: (0.25, 0.55, 1, 1)

            Label:
                text: root.phone_label
                halign: 'center'
                valign: 'middle'
                font_size: dp(13)
                color: (1, 1, 1, 1)
                text_size: self.width - dp(16), None

        FtpButton:
            id: btn_open_pc
            bg_color: (0.9, 0.5, 0.16, 1)
            pressed_color: (1, 0.6, 0.25, 1)

            Label:
                text: root.pc_label
                halign: 'center'
                valign: 'middle'
                font_size: dp(13)
                color: (1, 1, 1, 1)
                text_size: self.width - dp(16), None

    Widget:
