#:import dp kivy.metrics.dp

<SshButton>:
    canvas.before:
        Color:
            rgba: self.pressed_color if self.state == 'down' else self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]

<RoundedTextInput>:
    canvas.before:
        Color:
            rgba: root.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [root.radius]
    TextInput:
        id: input
        text: root.text
        hint_text: root.hint_text
        input_filter: root.input_filter
        background_color: 0, 0, 0, 0
        foreground_color: root.fg_color
        cursor_color: root.cursor_color
        padding: dp(12), dp(8)
        multiline: False
        font_size: dp(15)
        size_hint: 1, 1

<BackButton>:
    canvas.before:
        Color:
            rgba: (0.36, 0.36, 0.38, 1) if self.state == 'down' else (0.23, 0.23, 0.24, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<TermView>:

<SSHRoot>:
    orientation: 'vertical'
    padding: dp(12)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: 0.07, 0.07, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, None
        height: dp(48)
        spacing: dp(12)

        BackButton:
            id: btn_back

        Label:
            text: 'SSH'
            halign: 'left'
            valign: 'middle'
            font_size: dp(18)
            color: 0.95, 0.95, 0.95, 1
            text_size: self.size

        Widget:
            size_hint: 1, 1

    TermView:
        id: term
        size_hint: 1, 1
